const int TDShortLeft[13]={1,2,-1,4,-1,-1,7,8,-1,-1,11,-1,-1};
const int TDShortRight[13]={6,3,-1,5,-1,-1,10,9,-1,-1,12,-1,-1};
const int TDShortFeature[13]={166,366,-2,266,-2,-2,163,470,-2,-2,42,-2,-2};
const double TDShortThreshold[13]={0.22853560000658035,-0.51263871788978577,-2,0.19814405590295792,-2,-2,0.7890625,0.22985128313302994,-2,-2,0.093466334044933319,-2,-2};
const double TDShortValue[13]={-0.21842617076674345,-0.13899443583582616,-0.47709429344078891,-0.10972838893607977,-0.14413591156793154,0.16623879600842875,-0.32932062216785846,-0.42231854893216636,-0.46971660400899812,-0.18011448748955489,-0.19207005875483518,-0.34903240873589242,0.00033540251226756723};
double TDScoreShort(const double &raw[])
{
   int node=0;
   while(TDShortLeft[node]>=0)
   {
      int f=TDShortFeature[node];
      double v=(MathIsValidNumber(raw[f])&&raw[f]!=EMPTY_VALUE)?raw[f]:TDShortMedian[f];
      v=(double)(float)v; // sklearn tree input conversion
      node=(v<=TDShortThreshold[node])?TDShortLeft[node]:TDShortRight[node];
   }
   return TDShortValue[node];
}
int TDModelDecision(const double &raw[],double &long_score,double &short_score)
{
   if(ArraySize(raw)!=TD_MODEL_FEATURE_COUNT) return 0;
   long_score=TDScoreLong(raw); short_score=TDScoreShort(raw);
   if(MathMax(long_score,short_score)<TD_MODEL_THRESHOLD || long_score==short_score) return 0;
   return (long_score>short_score)?1:-1;
}
