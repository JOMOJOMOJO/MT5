+   s.minute=(datetime)(q.time/60*60);s.min_bid=q.bid;s.max_bid=q.bid;
+   if(s.risk<=0 || s.atr<=0 || s.tp<=s.entry){RBFatal("INVALID_SHADOW_PRICE");return;}
