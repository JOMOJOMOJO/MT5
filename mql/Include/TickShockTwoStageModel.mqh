double TS2ScoreLong(const double &raw[])
{
 double z=-0.20239237073037819;
 for(int i=0;i<TS2_USED_COUNT;++i){int j=TS2Index[i];
 double v=(MathIsValidNumber(raw[j])&&raw[j]!=EMPTY_VALUE)?raw[j]:TS2LongMedian[i];
 z+=(v-TS2LongMean[i])/TS2LongScale[i]*TS2LongCoefficient[i];
 }
 return z;
