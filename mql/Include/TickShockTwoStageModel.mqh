double TS2ScoreShort(const double &raw[])
{
 double z=-0.15928401557394006;
 for(int i=0;i<TS2_USED_COUNT;++i){int j=TS2Index[i];
 double v=(MathIsValidNumber(raw[j])&&raw[j]!=EMPTY_VALUE)?raw[j]:TS2ShortMedian[i];
 z+=(v-TS2ShortMean[i])/TS2ShortScale[i]*TS2ShortCoefficient[i];
 }
 return z;
}
