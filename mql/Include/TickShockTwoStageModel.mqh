double TS2ScoreTradeability(const double &raw[])
{
 double z=0.47677140221966802;
 for(int i=0;i<TS2_USED_COUNT;++i){int j=TS2Index[i];
 double v=(MathIsValidNumber(raw[j])&&raw[j]!=EMPTY_VALUE)?raw[j]:TS2TradeabilityMedian[i];
 z+=(v-TS2TradeabilityMean[i])/TS2TradeabilityScale[i]*TS2TradeabilityCoefficient[i];
 }
 return z;
}
