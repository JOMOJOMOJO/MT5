double TDScoreLong(const double &raw[])
{
 double z=-0.064072530195273203;
 for(int i=0;i<TD_MODEL_USED_FEATURES;++i){int j=TDUsedIndex[i];
 double v=(MathIsValidNumber(raw[j])&&raw[j]!=EMPTY_VALUE)?raw[j]:TDLongMedian[i];
 z+=(v-TDLongMean[i])/TDLongScale[i]*TDLongCoefficient[i];
 }
 return z;
}
