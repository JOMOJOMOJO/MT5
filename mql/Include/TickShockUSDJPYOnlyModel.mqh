double TDScoreShort(const double &raw[])
{
 double z=-0.026607737069920236;
 for(int i=0;i<TD_MODEL_USED_FEATURES;++i){int j=TDUsedIndex[i];
 double v=(MathIsValidNumber(raw[j])&&raw[j]!=EMPTY_VALUE)?raw[j]:TDShortMedian[i];
 z+=(v-TDShortMean[i])/TDShortScale[i]*TDShortCoefficient[i];
 }
 return z;
}
int TDModelDecision(const double &raw[],double &ls,double &ss)
{
 if(ArraySize(raw)!=TD_MODEL_FEATURE_COUNT)return 0;
 ls=TDScoreLong(raw);ss=TDScoreShort(raw);
 if(!MathIsValidNumber(ls)||!MathIsValidNumber(ss)||ls==ss||MathMax(ls,ss)<TD_MODEL_THRESHOLD)return 0;
 return ls>ss?1:-1;
}
