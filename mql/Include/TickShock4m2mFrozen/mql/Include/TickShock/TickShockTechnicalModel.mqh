double TDScoreLong(const double &raw[])
{
   double z=-0.17641157002355926;
   for(int i=0;i<TD_MODEL_FEATURE_COUNT;i++)
   {
      double v=(MathIsValidNumber(raw[i])&&raw[i]!=EMPTY_VALUE)?raw[i]:TDLongMedian[i];
      z+=(v-TDLongMean[i])/TDLongScale[i]*TDLongCoefficient[i];
   }
   double p=(z>=0.0)?1.0/(1.0+MathExp(-z)):MathExp(z)/(1.0+MathExp(z));
   return p*0.46331626287424621+(1.0-p)*-0.526079125846866;
}
